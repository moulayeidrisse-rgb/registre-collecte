# Copier ce fichier en .env et adapter les valeurs. Ne jamais committer .env.
# Chaîne de connexion PostgreSQL (serveur uniquement, jamais exposée au client)
DATABASE_URL="postgresql://registre:CHANGER_MOI@localhost:5432/registre_dev?schema=public"

# Durée de validité d'une session, en heures
SESSION_TTL_HOURS=8

# Cookie "Secure" : activé automatiquement en production. Mettre "false" uniquement
# pour un test local en HTTP avec `npm run start`.
COOKIE_SECURE=

# Mot de passe attribué aux comptes fictifs créés par le seed (démonstration uniquement)
SEED_PASSWORD="Demo-Registre-2026"
